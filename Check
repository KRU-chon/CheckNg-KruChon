<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>ตรวจงานนักเรียน</title>
<link href="https://fonts.googleapis.com/css2?family=Mali:wght@600;700&family=Sarabun:wght@400;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
<style>
:root{--paper:#fbfdff;--rule:#d3e3f7;--margin:#e0455b;--ink:#14284b;--pen:#2740b8;--ok:#0b8f5a;--warn:#c77700;--bad:#d1344a;--mute:#5a6a85}
*{box-sizing:border-box}
body{margin:0;font:17px/1.6 Sarabun,system-ui,sans-serif;color:var(--ink);background:var(--paper) repeating-linear-gradient(transparent 0 31px,var(--rule) 31px 32px)}
main{max-width:520px;min-height:100vh;margin:0 auto;padding:16px 16px 48px 24px;border-left:2px solid var(--margin)}
h1,h2,.res b{font-family:Mali,Sarabun,sans-serif;font-weight:700;line-height:1.3}
h1{font-size:30px;margin:12px 0 4px}
h2{font-size:21px;margin:12px 0 8px}
.sub{color:var(--mute);margin:0 0 12px}
button,input{font:inherit;color:inherit}
.card,.opt{display:block;width:100%;text-align:left;background:#fff;border:1.5px solid var(--ink);border-radius:10px;padding:14px 16px;margin:10px 0;cursor:pointer}
.card b{font-family:Mali,sans-serif;font-size:20px}
.card small{display:block;color:var(--mute)}
.opt:active,.card:active{background:#eef3ff}
.go{background:var(--pen);color:#fff;border:0;border-radius:10px;padding:12px 18px;font-weight:600;white-space:nowrap}
.go:disabled{opacity:.4}
.ghost{background:none;border:0;color:var(--pen);font-weight:600;padding:10px 0}
input{width:100%;padding:12px;border:1.5px solid var(--ink);border-radius:10px;background:#fff}
input:focus-visible,button:focus-visible{outline:3px solid #8aa2ff;outline-offset:2px}
.row{display:flex;gap:8px;margin:10px 0}
.steps{display:flex;gap:5px;margin-top:6px}
.steps i{flex:1;height:5px;border-radius:3px;background:var(--rule)}
.steps i.on{background:var(--pen)}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
.chip{padding:6px 14px;border-radius:99px;border:1.5px solid var(--ink);background:#fff}
.chip.on{background:var(--ink);color:#fff}
#reader{border-radius:10px;overflow:hidden;background:#111;min-height:180px}
.res{border-radius:10px;padding:14px;text-align:center;font-size:20px;margin:12px 0;background:#fff;border:1.5px solid var(--rule)}
.res b{font-size:26px;display:block}
.res.ok{background:#e3f6ec;border-color:var(--ok);color:#075c3a}
.res.dup{background:#fff2d6;border-color:var(--warn);color:#7a4700}
.res.bad{background:#fde6e9;border-color:var(--bad);color:#8f1d2f}
.t{display:flex;justify-content:space-between;gap:8px;padding:6px 0;border-bottom:1px solid var(--rule)}
.y{color:var(--ok);font-weight:600}.n{color:var(--bad)}
@media(prefers-reduced-motion:no-preference){.res{transition:background .2s}}
</style>
</head>
<body>
<main id="app"></main>
<script>
// วาง URL ของ Apps Script (ลงท้ายด้วย /exec) ตรงนี้
const API='https://script.google.com/macros/s/AKfycbz1OfBJVKOSNFLW-X2Wwnqks8HO4Dc24nx9iLUGIbKGmNjmsdMrjyHgoQwggQXaPNWb/exec';

const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const S=JSON.parse(localStorage.hw||'{"tasks":[],"cur":0}'),save=()=>localStorage.hw=JSON.stringify(S);
const NAMES=['','เปิดเว็บไซต์','เลือกห้อง','เลือกวิชา','เพิ่มงาน','สแกน'];
let meta,scanner,last='',lastT=0,busy=false,cnt={},ac;

const call=async o=>{try{return await(await fetch(API+'?'+new URLSearchParams(o))).json()}
  catch(e){return{ok:false,msg:'เชื่อมต่อไม่ได้ ตรวจสอบอินเทอร์เน็ตและลิงก์ Apps Script'}}};
const app=h=>$('#app').innerHTML=h;
const shell=(n,h)=>{stop();app(`<div class=steps>${[1,2,3,4,5].map(i=>`<i class="${i<=n?'on':''}"></i>`).join('')}</div><p class=sub>ขั้นที่ ${n} จาก 5: ${NAMES[n]}</p>`+h)};
const back=()=>'<button class=ghost onclick=home()>← หน้าแรก</button>';

function home(){stop();app(`<h1>ตรวจงานนักเรียน</h1><p class=sub>สแกนบาร์โค้ดรหัสนักเรียนด้วยกล้องโทรศัพท์</p>
<button class=card onclick=rooms()><b>โหมดครู</b><small>เลือกห้อง วิชา แล้วสแกนตรวจงาน</small></button>
<button class=card onclick=par()><b>โหมดผู้ปกครอง</b><small>ดูว่าบุตรหลานส่งงานครบหรือยัง</small></button>`)}

async function rooms(){
  if(API.includes('PASTE'))return shell(2,'<p class=n>ยังไม่ได้ใส่ลิงก์ Apps Script ในไฟล์ index.html</p>'+back());
  shell(2,'<p>กำลังโหลดรายชื่อห้อง…</p>');
  meta=await call({a:'init'});
  if(!meta.ok)return shell(2,`<p class=n>${esc(meta.msg)}</p><button class=go onclick=rooms()>ลองใหม่</button>`+back());
  shell(2,'<h2>เลือกห้องที่จะสแกน</h2>'+meta.rooms.map((r,i)=>`<button class=opt onclick="pickRoom(${i})">${esc(r.name)} <small>(${r.n} คน)</small></button>`).join('')+back());
}
function pickRoom(i){S.ri=i;S.room=meta.rooms[i].name;save();subjects()}

function subjects(){
  shell(3,`<h2>ห้อง ${esc(S.room)}: เลือกวิชา</h2>`+meta.rooms[S.ri].subjects.map((s,i)=>`<button class=opt onclick="pickSub(${i})">${esc(s.name)} <small>(${s.n} คน)</small></button>`).join('')
  +'<button class=ghost onclick=rooms()>← เปลี่ยนห้อง</button>')}
function pickSub(i){const s=meta.rooms[S.ri].subjects[i];S.subject=s.name;S.n=s.n;S.tasks=[];S.cur=0;save();tasks()}

function tasks(){
  shell(4,`<h2>${esc(S.room)}: ${esc(S.subject)}</h2><p class=sub>เพิ่มงานที่จะสแกนในรอบนี้ (เพิ่มได้หลายงาน)</p>
<div class=row><input id=nt placeholder="ชื่องาน เช่น แบบฝึกหัดบทที่ 3" onkeydown="event.key=='Enter'&&addT()"><button class=go onclick=addT()>เพิ่ม</button></div>
<div class=chips>${S.tasks.map((t,i)=>`<span class=chip>${esc(t)} <b onclick="delT(${i})" style="cursor:pointer">✕</b></span>`).join('')||'<small class=sub>ยังไม่มีงาน</small>'}</div>
<button class=go style="width:100%" onclick=scan() ${S.tasks.length?'':'disabled'}>เริ่มสแกน</button><button class=ghost onclick=subjects()>← เปลี่ยนวิชา</button>`)}
function addT(){const v=$('#nt').value.trim();if(v){S.tasks.push(v);save()}tasks();$('#nt').focus()}
function delT(i){S.tasks.splice(i,1);S.cur=0;save();tasks()}

const tabs=()=>S.tasks.map((t,i)=>`<button class="chip ${i==S.cur?'on':''}" onclick="setT(${i})">${esc(t)}</button>`).join('');
const tally=()=>$('#cn').textContent=`ตรวจแล้ว ${cnt[S.tasks[S.cur]]||0} จาก ${S.n} คน`;
const show=(h,c)=>{$('#res').className='res '+c;$('#res').innerHTML=h};
function setT(i){S.cur=i;save();$('#tabs').innerHTML=tabs();tally()}

function scan(){
  if(!S.pin){S.pin=prompt('กรอกรหัสครู')||'';save()}
  S.cur=Math.min(S.cur,S.tasks.length-1);cnt={};
  shell(5,`<div id=reader></div><div class=chips id=tabs>${tabs()}</div><p class=sub id=cn></p>
<div id=res class=res>เล็งบาร์โค้ดให้อยู่ในกรอบ</div>
<form class=row onsubmit="event.preventDefault();manual()"><input id=mi inputmode=numeric maxlength=5 placeholder="หรือพิมพ์รหัส 5 หลัก"><button class=go>ตกลง</button></form>
<div id=log></div><button class=ghost onclick=tasks()>← กลับไปแก้งาน</button>`);
  tally();start();
}
async function start(){
  try{const F=Html5QrcodeSupportedFormats;
    scanner=new Html5Qrcode('reader',{formatsToSupport:[F.CODE_128,F.CODE_39,F.CODE_93,F.EAN_13,F.EAN_8,F.ITF,F.CODABAR,F.UPC_A,F.QR_CODE],useBarCodeDetectorIfSupported:true,verbose:false});
    await scanner.start({facingMode:'environment'},{fps:10,qrbox:{width:280,height:120}},onCode,()=>{});
  }catch(e){$('#reader').innerHTML='<p style="color:#fff;padding:16px">เปิดกล้องไม่ได้ กรุณาอนุญาตการใช้กล้อง และเปิดเว็บผ่าน https เท่านั้น (ยังพิมพ์รหัสด้านล่างแทนได้)</p>'}
}
function stop(){if(scanner){scanner.stop().catch(()=>{});scanner=null}}

function onCode(txt){
  const id=txt.trim(),now=Date.now();
  if(!/^\d{5}$/.test(id)||busy||(id===last&&now-lastT<3000))return;
  last=id;lastT=now;submit(id);
}
function manual(){const v=$('#mi').value.trim();$('#mi').value='';/^\d{5}$/.test(v)?submit(v):show('รหัสต้องเป็นตัวเลข 5 หลัก','bad')}
const beep=f=>{try{ac=ac||new(window.AudioContext||webkitAudioContext)();const o=ac.createOscillator();o.frequency.value=f;o.connect(ac.destination);o.start();o.stop(ac.currentTime+.12)}catch(e){}};

async function submit(id){
  if(busy)return;busy=true;const t=S.tasks[S.cur];show('กำลังบันทึก…','');
  const r=await call({a:'scan',pin:S.pin,room:S.room,subject:S.subject,task:t,date:new Date().toLocaleDateString('th-TH'),id});
  busy=false;if(!$('#res'))return;
  if(r.pin){S.pin=prompt('รหัสครูไม่ถูกต้อง กรอกใหม่อีกครั้ง')||'';save()}
  if(!r.ok){beep(180);navigator.vibrate&&navigator.vibrate(300);return show(esc(r.msg),'bad')}
  if(!r.dup)cnt[t]=(cnt[t]||0)+1;
  beep(r.dup?440:880);navigator.vibrate&&navigator.vibrate(80);
  show(`<b>${r.dup?'สแกนซ้ำ':'✓ บันทึกแล้ว'}</b>${esc(r.name)} (${r.id})`,r.dup?'dup':'ok');
  tally();$('#log').insertAdjacentHTML('afterbegin',`<div class=t><span>${esc(r.name)}</span><span class=${r.dup?'n':'y'}>${r.id}</span></div>`);
  while($('#log').children.length>6)$('#log').lastChild.remove();
}

function par(){
  stop();app(`<h1>ตรวจงานบุตรหลาน</h1><p class=sub>กรอกรหัสประจำตัวนักเรียน 5 หลัก</p>
<input id=pi inputmode=numeric maxlength=5 placeholder="รหัสนักเรียน 5 หลัก"><div class=row><input id=pc placeholder="รหัสผู้ปกครอง (ถ้าครูแจ้งไว้)"></div>
<button class=go style="width:100%" onclick=look()>ดูการส่งงาน</button><div id=pr></div>${location.hash=='#parent'?'':back()}`)}
async function look(){
  const id=$('#pi').value.trim();
  if(!/^\d{5}$/.test(id))return $('#pr').innerHTML='<p class=n>รหัสต้องเป็นตัวเลข 5 หลัก</p>';
  $('#pr').innerHTML='<p>กำลังโหลด…</p>';
  const r=await call({a:'parent',id,code:$('#pc').value.trim()});
  if(!r.ok)return $('#pr').innerHTML=`<p class=n>${esc(r.msg)}</p>`;
  $('#pr').innerHTML=`<h2>${esc(r.name)} ห้อง ${esc(r.room)}</h2>`+(r.subjects.map(s=>{
    const d=s.tasks.filter(t=>t.done).length;
    return `<div class=card style="cursor:default"><b>${esc(s.subject)}</b> <small>ส่งแล้ว ${d} จาก ${s.tasks.length} งาน</small>`
    +s.tasks.map(t=>`<div class=t><span>${esc(t.t.replace('\n',' '))}</span><span class="${t.done?'y':'n'}">${t.done?'✓ ส่งแล้ว':'ยังไม่ส่ง'}</span></div>`).join('')+'</div>'}).join('')||'<p>ยังไม่มีงานที่บันทึก</p>');
}

location.hash=='#parent'?par():home();
</script>
</body>
</html>
